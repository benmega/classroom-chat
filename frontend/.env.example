# Copy to `.env` (git-ignored) to change these for local development.
# Vite also reads them from the shell environment, which takes precedence.
# Restart `npm run dev` after editing.

# Origin of the backend API and Socket.IO server. Leave unset in development: requests
# then go to the page's own origin and the Vite dev/preview proxy forwards them to the
# backend. Set it only when the frontend is hosted apart from the API; the backend must
# then list the frontend origin in its CORS_ORIGINS (see backend/.env.example).
# The S3/CloudFront build (.github/workflows/deploy-frontend.yml) sets it to:
# VITE_API_URL=https://api-blossom.benmega.com

# Backend that `npm run dev` and `npm run preview` proxy to (see vite.config.js).
# Defaults to http://localhost:8000.
# VITE_DEV_API=http://localhost:8000
