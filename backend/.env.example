# Copy to backend/.env for local development. This file is NOT used in production:
# deploy.yml writes the server's backend/.env itself, including FLASK_ENV=production.
FLASK_ENV=development

# SECRET_KEY and ADMIN_PASSWORD are required when FLASK_ENV=production (the app refuses
# to start without them). In development, leaving them empty uses insecure dev defaults.
# Generate a SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Production database (SQLite file). deploy.yml writes this path on the server; leave it
# commented out for local development (see DEV_DATABASE_URI below).
# DATABASE_URL=sqlite:////home/ubuntu/classroom-chat/backend/instance/prod_users.db

# Shared secret for the webhook endpoints. Leave empty to reject all webhook calls.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# Dev-only overrides (not needed in production)
# DEV_DATABASE_URI=sqlite:///dev_users.db

# Optional / tuning (all read by the code; deploy.yml writes only the two AWS keys)
# CORS_ORIGINS=https://blossom.benmega.com,https://api-blossom.benmega.com   # comma-separated; defaults in config.py if unset
# SOCKETIO_ASYNC_MODE=gevent      # read by main.py and config.py; default gevent
# PORT=8000                       # only used by `python main.py`
# FLASK_DEBUG=True                # only used by `python main.py`
# FLASK_USE_RELOADER=True         # only used by `python main.py`; set False to disable the auto-reloader
# PROFILE_BASE_URL=https://blossom.benmega.com   # only used by the QR-code tools in tools/
# AWS_ACCESS_KEY_ID=              # S3 access for notes/uploads (leave unset to disable)
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-1
# S3_NOTES_BUCKET=classroom-chat-student-notes          # bucket for student notes images
# S3_UPLOAD_BUCKET=youtube-upload-source-classroom-chat # bucket for project video uploads

# AWS SES email (all optional)
# AWS_SES_REGION=ap-southeast-1   # SES region
# SES_SENDER_EMAIL=noreply@benmega.com   # From address for outgoing mail
# ADMIN_EMAIL_ADDRESS=            # where admin notification emails are sent (unset disables them)
# AWS_SES_ACCESS_KEY_ID=          # dedicated SES credentials; falls back to the default AWS credentials
# AWS_SES_SECRET_ACCESS_KEY=

# AWS Cognito Configuration
COGNITO_USER_POOL_ID=your_user_pool_id
COGNITO_CLIENT_ID=your_client_id
COGNITO_CLIENT_SECRET=your_client_secret
COGNITO_DOMAIN=your_cognito_domain.auth.us-east-1.amazoncognito.com
COGNITO_REDIRECT_URI=http://localhost:5173/api/auth/cognito/callback
COGNITO_REGION=us-east-1
